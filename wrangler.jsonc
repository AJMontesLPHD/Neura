{
  "name": "lphd-neura",
  "main": "worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  }, 
"r2_buckets": [
  {
    "binding": "NEURA_REFERENCES",
    "bucket_name": "neura-references"
  }
]
}
